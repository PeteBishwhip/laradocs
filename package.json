{
  "name": "laradocs",
  "private": true,
  "type": "module",
  "description": "Test harness for the bundled palette JS. The package itself ships no Node build step — `resources/dist/laradocs.js` is hand-authored and committed.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "sponsorkit",
    "test": "node --test --test-reporter=spec tests/js/palette.test.mjs tests/js/version.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "jsdom": "^30.0.1",
    "sponsorkit": "^18.0.0"
  }
}
